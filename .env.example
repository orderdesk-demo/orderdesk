# Copy this file to .env and fill in your values. .env is gitignored. Never commit real tokens.

# DevRev Personal Access Token
# Create one in DevRev: Settings > Account > Personal Access Token > New token
DEVREV_PAT=

# Optional: DevRev API base URL (default shown)
# DEVREV_API_BASE=https://api.devrev.ai

# MCP server (POST /mcp) for DevRev Computer's custom MCP connector
# Require "Authorization: Bearer <key>" on /mcp. Strongly recommended once the URL is public.
# MCP_API_KEY=
# Expose the update_order_status tool (default: read-only tools only)
# MCP_ALLOW_WRITES=true
# Also serve ONLY /mcp on this port (localhost). Point a public tunnel here so the
# web app and REST API are not exposed along with the connector.
# MCP_PORT=4100

# Optional: server port (default 3000)
# PORT=4000
